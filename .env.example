# Coffee model inference service (model-service/ — FastAPI + EfficientNetB0).
#
# Leave COFFEE_MODEL_ENDPOINT unset (or blank/invalid) to run the clearly-labeled
# mock adapter (mock-coffee). Set it to the base URL of the hosted model service
# (NO trailing /predict and NO trailing slash needed) to activate the real
# adapter — the service must also have the .keras checkpoint loaded
# (GET /health → 200 "ready").
#
# The URL is read server-side only; never expose it to the client bundle.
# Example: COFFEE_MODEL_ENDPOINT=http://model-service.internal:8100
COFFEE_MODEL_ENDPOINT=

# Optional: per-request timeout (milliseconds) for /health and /predict calls.
# Minimum 250 ms; invalid or unset values fall back to the 15000 ms default.
COFFEE_MODEL_SERVICE_TIMEOUT_MS=15000
