# =====================================================================
# model-service/.env.example — PLACEHOLDERS ONLY. Copy to .env (which is
# gitignored) or pass values directly: uvicorn --env-file .env app.main:app
# There are NO credentials in this service; only paths and metadata.
# =====================================================================

# Where the trained checkpoint lives. Absolute path in production, or a path
# relative to model-service/ (default shown below; the checkpoints/ dir is
# gitignored — the .keras file is never committed).
# If unset, the service uses this same default and, with no file present,
# fails clearly on /health (=503, reason "Checkpoint not found …").
COFFEE_MODEL_PATH=checkpoints/coffee_efficientnetb0_finetuned_best.keras

# Stage-1 binary health checkpoint (Healthy=0 / Unhealthy=1, single sigmoid).
# Same resolution rules as COFFEE_MODEL_PATH.
COFFEE_HEALTH_MODEL_PATH=checkpoints/coffee_health_efficientnetb0_best.keras

# Binary routing threshold for /predict-health (probability >= threshold ⇒
# Unhealthy ⇒ the four-disease classifier runs). Validation-selected default
# 0.2244; configurable per deployment, never tuned on test data.
#COFFEE_UNHEALTHY_THRESHOLD=0.2244

# Version string surfaced by /health and /predict. Must match
# docs/technical/model-documentation.md in the application repository.
COFFEE_MODEL_VERSION=1.0.0
